APP_NAME="FM Operational API"
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/farm_management_operational
INTERNAL_API_KEY=replace-with-a-different-long-random-value
INTERNAL_API_PREVIOUS_KEY=
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=fm-platform-api
JWT_AUDIENCE=fm-frontend
JWT_TTL_HOURS=8
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# finance-service internal API: customers for ABK egg outflows and delivery of approved egg sales.
FINANCE_BASE_URL=http://127.0.0.1:8002
FINANCE_INTERNAL_API_KEY=replace-with-the-key-finance-service-accepts
FINANCE_TIMEOUT_SECONDS=10